GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=text-bison@001
# Optional: a generic HTTP wrapper for Gemini if you prefer calling an HTTP endpoint
# GEMINI_HTTP_URL=https://your-gemini-proxy.example.com/generate
PORT=3000
DATABASE_URL=postgresql://username:password@localhost:5432/emergency_db
REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8000
APP_NAME=LifeBridge Emergency Dispatch System
NODE_ENV=development
LOG_LEVEL=info
